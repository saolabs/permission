{
    "name": "saola/permission",
    "description": "Optional role and permission management for Saola applications",
    "type": "library",
    "license": "MIT",
    "authors": [{"name": "SaoLabs Team", "homepage": "https://saolabs.dev"}],
    "require": {
        "php": "^8.2",
        "saola/core": "^2.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.0 || ^12.0"
    },
    "autoload": {"psr-4": {"Saola\\Permission\\": "src/"}},
    "autoload-dev": {"psr-4": {"Saola\\Permission\\Tests\\": "tests/"}},
    "extra": {"laravel": {"providers": ["Saola\\Permission\\PermissionServiceProvider"]}},
    "scripts": {
        "test": "phpunit",
        "check": ["composer validate --strict --no-interaction", "composer audit --locked", "@test"]
    },
    "config": {"sort-packages": true},
    "minimum-stability": "stable",
    "prefer-stable": true
}
